# Copy to .env and fill in. Never commit .env.
# Pick ONE provider (Gemini has a free tier):
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: force a provider when both keys are set (gemini | anthropic)
# LLM_PROVIDER=gemini
# Optional: override the model, e.g. gemini-2.5-flash or the one you use in Google AI Studio
# CLAIMSPILOT_MODEL=gemini-2.5-flash
